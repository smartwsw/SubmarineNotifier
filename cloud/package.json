{
  "name": "submarine-notifier-cloud",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "db:migrate:local": "wrangler d1 migrations apply submarine-notifier --local",
    "db:migrate:remote": "wrangler d1 migrations apply submarine-notifier --remote"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261110.1",
    "@cloudflare/vitest-pool-workers": "^0.23.0",
    "typescript": "^5.9.3",
    "vitest": "4.1.12",
    "wrangler": "^4.160.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "esbuild@0.28.2": true,
    "workerd@1.20260815.1": true,
    "workerd@1.20261110.1": true
  }
}
